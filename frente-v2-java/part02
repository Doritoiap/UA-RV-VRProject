    private void loadCustomData() {
        customCategories.clear();
        savedMixes.clear();
        try {
            JSONObject cats = new JSONObject(prefs.getString(KEY_CUSTOM_CATEGORIES, "{}"));
            JSONArray catNames = cats.names();
            if (catNames != null) {
                for (int i = 0; i < catNames.length(); i++) {
                    String name = catNames.getString(i);
                    customCategories.put(name, jsonArrayToList(cats.getJSONArray(name)));
                }
            }
            JSONObject mixes = new JSONObject(prefs.getString(KEY_SAVED_MIXES, "{}"));
            JSONArray mixNames = mixes.names();
            if (mixNames != null) {
                for (int i = 0; i < mixNames.length(); i++) {
                    String name = mixNames.getString(i);
                    savedMixes.put(name, jsonArrayToList(mixes.getJSONArray(name)));
                }
            }
        } catch (JSONException ignored) {
            customCategories.clear();
            savedMixes.clear();
        }
    }

    private List<String> jsonArrayToList(JSONArray array) throws JSONException {
        List<String> out = new ArrayList<>();
        for (int i = 0; i < array.length(); i++) out.add(array.getString(i));
        return out;
    }

    private void saveCustomData() {
        JSONObject cats = new JSONObject();
        JSONObject mixes = new JSONObject();
        try {
            for (Map.Entry<String, List<String>> e : customCategories.entrySet()) cats.put(e.getKey(), new JSONArray(e.getValue()));
            for (Map.Entry<String, List<String>> e : savedMixes.entrySet()) mixes.put(e.getKey(), new JSONArray(e.getValue()));
        } catch (JSONException ignored) { }
        prefs.edit()
                .putString(KEY_CUSTOM_CATEGORIES, cats.toString())
                .putString(KEY_SAVED_MIXES, mixes.toString())
                .apply();
    }

    private Map<String, List<String>> availableCategories() {
        Map<String, List<String>> all = new LinkedHashMap<>();
        all.putAll(builtInCategories);
        all.putAll(customCategories);
        return all;
    }

    private List<String> allWords() {
        Set<String> unique = new LinkedHashSet<>();
        for (List<String> words : availableCategories().values()) unique.addAll(words);
        return new ArrayList<>(unique);
    }

    private List<String> resolveMix(List<String> categoryNames) {
        Map<String, List<String>> all = availableCategories();
        Set<String> unique = new LinkedHashSet<>();
        for (String categoryName : categoryNames) {
            List<String> words = all.get(categoryName);
            if (words != null) unique.addAll(words);
        }
        return new ArrayList<>(unique);
    }

    private TextView text(String value, int sizeSp, boolean bold) {
        TextView v = new TextView(this);
        v.setText(value);
        v.setTextColor(Color.rgb(24, 24, 24));
        v.setTextSize(sizeSp);
        v.setGravity(Gravity.CENTER);
        v.setPadding(dp(14), dp(10), dp(14), dp(10));
        if (bold) v.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        return v;
    }

    private Button button(String label) {
        Button b = new Button(this);
        b.setText(label);
        b.setTextSize(18);
        b.setAllCaps(false);
        b.setMinHeight(dp(54));
        return b;
    }

    private TextView sectionLabel(String label) {
        TextView v = text(label, 15, true);
        v.setGravity(Gravity.START | Gravity.CENTER_VERTICAL);
        v.setTextColor(Color.rgb(90, 90, 90));
        v.setPadding(dp(4), dp(22), dp(4), dp(4));
        return v;
    }

